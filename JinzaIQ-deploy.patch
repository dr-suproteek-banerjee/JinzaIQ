+
+export function JobCard({ item }: { item: JobWithMatch }) {
+  const { job, match } = item;
+  return (
+    <article className="card job-card">
+      <div>
+        <div className="subtle">{job.company.name} · {job.location} · {job.remote_policy}</div>
